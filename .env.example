# 复制为 apps/web/.env.local（本机）；Vercel 里逐条填环境变量
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # 只在服务端用，绝不进浏览器
SUPABASE_PROJECT_ID=xxxx                  # pnpm gen:types 用
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_EXTRACT=claude-sonnet-4-5 # 抽取用；按 console 里的最新型号改
ANTHROPIC_MODEL_FAST=claude-haiku-4-5     # 分类 / 摘要用
APP_TIMEZONE=America/Chicago
