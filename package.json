{
  "name": "newbee-os",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "gen:types": "supabase gen types typescript --linked --schema public > packages/core/src/types/database.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset --linked",
    "supabase": "supabase"
  },
  "devDependencies": {
    "supabase": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
